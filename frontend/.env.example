# Add to the shared Vercel Services project Environment Variables; never commit real secrets
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
AUTH_SECRET=replace-with-a-unique-random-string-of-at-least-32-characters
DJANGO_SECRET_KEY=replace-with-a-different-unique-random-string-of-at-least-32-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,your-production-domain.example
# For the one-time local bootstrap script only:
ADMIN_NAME=Initial Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Maps requires a Google Cloud API key with Maps JavaScript API and billing enabled
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
